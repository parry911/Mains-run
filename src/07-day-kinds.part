/* ---------- day kinds ---------- */
const KIND_LABEL={normal:"Normal day",gstest:"GS test day",essay:"Essay day",centre:"Centre test",travel:"Travel day",wedding:"Wedding",off:"Off",light:"Light Sunday"};
const UNTIMED={travel:240,wedding:240,centre:180,off:0,light:0};
function testOn(d,T){return T.find(x=>x.date===d&&!x.skipped&&!x.opt)}
function dayHours(d){const l=logs[d];if(!l)return null;if(l.realH!=null)return +l.realH;const b=Object.values(l.blocks||{});if(b.length)return b.reduce((s,x)=>s+(x.nostudy?0:+x.hours||0),0);return l.hours!=null?+l.hours:null}
function dayAdmin(d){const l=logs[d];if(!l)return 0;return Object.values(l.blocks||{}).reduce((s,x)=>s+(x.nostudy?+x.hours||0:0),0)}
/* sleep: "fell asleep at" is minutes after midnight; 12:00 or later means the evening before */
function sleepMins(a,start){if(a==null||start==null)return null;return a>=720?1440-a+start:start-a}
function idealStart(a){const t=a>=720?a+420-1440:a+420;return Math.min(t,450)}
function idealText(a,startM){
  const ideal=idealStart(a),dr=sleepMins(a,startM);
  if(dr<360)return "Ideal start: "+hm(ideal)+". You fell asleep at "+hm(a)+", and starting earlier borrows from the afternoon, which is when this plan asks the most of you."+(startM<ideal?" Earlier than ideal, so the short-night version of today applies.":" The short-night version of today applies.");
  return "Ideal start: "+hm(ideal)+". You slept enough for the day to run at full length.";
}
let asleepDraft={};
function defaultAsleep(d){if(asleepDraft[d]!=null)return asleepDraft[d];const pd=add(d,-1),pl=logs[pd];if(pl&&pl.lightsAt!=null)return pl.lightsAt;if(pd>=START&&TS){const pp=dayPlan(pd,TS);if(pp.lights!=null)return pp.lights}return 1290}
function monSatHours(sun){let s=0;for(let i=6;i>=1;i--)s+=dayHours(add(sun,-i))||0;return s}
function lightEarned(d){return dow(d)===0&&d<=todayIST()&&monSatHours(d)>=RULES.sundayH}
function autoKind(d,T){
  const t=testOn(d,T);
  if(t){if(t.delhi&&t.date===t.orig)return "centre";return t.kind==="essay"?"essay":"gstest"}
  if(TRAVEL[d])return "travel";
  if(dow(d)===0&&lightEarned(d))return "light";
  return "normal";
}
function dayKind(d,T){
  const m=(plan.days||{})[d];
  if(m==="normal"){const a=autoKind(d,T);return a==="gstest"||a==="essay"||a==="centre"?a:"normal"}
  if(m==="travel"||m==="wedding"||m==="off")return m;
  return autoKind(d,T);
}
function defaultStart(d,T){const pr=add(d,-1);return pr>=START&&dayKind(pr,T)==="gstest"?RULES.afterTest:300}
function startOf(d,T){const l=logs[d];if(l&&l.start!=null)return{s:+l.start,how:l.startHow||"tap",set:true};return{s:defaultStart(d,T),how:"model",set:false}}

