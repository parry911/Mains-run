<style>
#sosBtn{position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:40;background:var(--margin);color:#fff;border:0;border-radius:999px;padding:14px 22px;font:800 15px/1 var(--display);letter-spacing:.08em;box-shadow:0 8px 22px rgba(0,0,0,.25)}
#sosOv{position:fixed;inset:0;z-index:60;background:rgba(10,16,28,.55);display:flex;align-items:flex-end;justify-content:center}
#sosOv[hidden]{display:none!important}
#sosSheet{background:var(--page);color:var(--ink);width:100%;max-width:640px;height:min(86vh,760px);border-radius:20px 20px 0 0;display:flex;flex-direction:column;padding:16px 16px calc(14px + env(safe-area-inset-bottom,0px));gap:12px;box-sizing:border-box}
@media (min-width:700px){#sosOv{align-items:center}#sosSheet{border-radius:20px}}
.sos-head{display:flex;justify-content:space-between;align-items:center;gap:10px}
.sos-head h3{font:800 20px/1.2 var(--display)}
.sos-x{border:0;background:var(--soft);border-radius:999px;padding:9px 13px;font:600 14px/1 var(--body);color:var(--ink)}
.sos-body{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:10px;-webkit-overflow-scrolling:touch}
.sos-choice{width:100%;text-align:left;padding:16px;border-radius:14px;border:1.5px solid var(--rule);background:var(--soft);font:700 17px/1.3 var(--body);letter-spacing:0;color:var(--ink)}
.sos-choice small{display:block;font-weight:400;color:var(--muted);font-size:14px;margin-top:4px;line-height:1.4}
.sos-choice.hot{border-color:color-mix(in srgb,var(--margin) 55%,var(--page));background:color-mix(in srgb,var(--margin) 10%,var(--page))}
.sos-m{padding:11px 14px;border-radius:16px;max-width:92%;font-size:15.5px;line-height:1.55;white-space:pre-wrap;word-wrap:break-word}
.sos-m.c{background:var(--soft);align-self:flex-start;border-bottom-left-radius:6px}
.sos-m.u{background:color-mix(in srgb,var(--accent) 24%,var(--page));align-self:flex-end;border-bottom-right-radius:6px}
.sos-m.err{background:var(--late-bg);color:var(--late)}
.sos-in{display:flex;gap:8px;align-items:flex-end}
.sos-in textarea{min-height:50px;max-height:150px;flex:1;font-size:16px}
.sos-in button{flex:none;padding:13px 15px;border-radius:12px}
.sos-mic[data-on="1"]{background:var(--margin);border-color:var(--margin);color:#fff}
.sos-food li{padding:8px 0;border-bottom:1px solid var(--rule);font-size:15px}
.sos-food{list-style:none;margin:0;padding:0}
/* the SOS button never covers a sheet's Save button */
body:has(.overlay:not([hidden])) #sosBtn{display:none}
</style>
<button id="sosBtn" type="button" aria-label="SOS: get help right now">SOS</button>
<div id="sosOv" hidden><div id="sosSheet" role="dialog" aria-modal="true" aria-labelledby="sosTitle">
  <div class="sos-head"><h3 id="sosTitle">SOS</h3><button type="button" class="sos-x" id="sosClose">Close</button></div>
  <div class="sos-body" id="sosBody"></div>
  <div class="sos-in" id="sosIn" hidden>
    <textarea id="sosText" rows="2" placeholder="Tell me what's going on…" aria-label="Your message"></textarea>
    <button type="button" class="sos-mic" id="sosMic" hidden aria-label="Speak">🎙</button>
    <button type="button" class="primary" id="sosSend">Send</button>
  </div>
</div></div>
