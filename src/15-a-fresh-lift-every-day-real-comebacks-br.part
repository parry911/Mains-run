/* ---------- a fresh lift every day: real comebacks, brain science, Gurbani (no repeats before 3 Jan) ---------- */
const L_ST=[
 {t:"s",h:"Three prelims failures. Then AIR 1.",body:"Shakti Dubey started in 2018 and failed prelims in her first three attempts. In her fourth she cleared mains but still missed the final list. In her fifth she was AIR 1 of CSE 2024.",take:"One mains result is a data point, not a verdict. She had four of them before rank one.",who:"Shakti Dubey · AIR 1, CSE 2024",url:"https://vajiramandravi.com/upsc-exam/shakti-dubey-upsc-air-1-2024/"},
 {t:"s",h:"He was already IPS. He kept studying.",body:"Aditya Srivastava left Goldman Sachs, failed prelims in 2021, got AIR 236 and the IPS in 2022, and kept preparing through police training. In 2023 he topped the country.",take:"He studied around a full training schedule. You have the whole day.",who:"Aditya Srivastava · AIR 1, CSE 2023",url:"https://indianmasterminds.com/feature-stories-on-bureaucrats-changemakers/exclusive-meet-ips-officer-trainee-aditya-srivastava-who-topped-upsc-cse-2023-with-air-1"},
 {t:"s",h:"An athlete, not a bookworm.",body:"Ishita Kishore played national-level football in the Subroto Cup and worked at EY. She failed prelims in her first two attempts, then topped CSE 2022.",take:"An all-rounder can top this exam. Your interests aren't the enemy; drift is.",who:"Ishita Kishore · AIR 1, CSE 2022",url:"https://vajiramandravi.com/upsc-exam/ishita-kishore-upsc-air-1-2022/"},
 {t:"s",h:"40–45 hours a week. Not 80.",body:"Accounts of Ishita Kishore's AIR 1 preparation describe a disciplined plan of about 40–45 hours a week: steady, not heroic.",take:"Six honest days beat two marathon days and a crash. Protect the rhythm.",who:"Ishita Kishore · AIR 1, CSE 2022",url:"https://www.nextias.com/ishita-kishore-cse-2022"},
 {t:"s",h:"He wasn't sure he'd crack it.",body:"Shubham Kumar failed his first attempt in 2018, got AIR 290 in 2019, and tried again while in training. After topping CSE 2020 he said he hadn't been sure he would crack it that year.",take:"Doubt isn't a signal to stop. Even AIR 1 felt it. Write anyway.",who:"Shubham Kumar · AIR 1, CSE 2020",url:"https://www.nationalheraldindia.com/national/wasnt-sure-about-cracking-exams-this-time-upsc-topper"},
 {t:"s",h:"A Sonipat farmer's son. Fourth attempt.",body:"Pradeep Singh, a farmer's son from Sonipat in Haryana, was already an IRS (Customs) officer when he topped CSE 2019. It was his fourth attempt.",take:"From right next door. Fourth attempt, rank one.",who:"Pradeep Singh · AIR 1, CSE 2019",url:"https://www.clearias.com/pradeep-singh-ias-rank-1/"},
 {t:"s",h:"His father sold their house.",body:"Another Pradeep Singh, from Indore, is the son of a petrol pump worker who sold the family home to fund his preparation. He got AIR 93 in his first attempt, then came back for AIR 26 in CSE 2019.",take:"He cleared it and still came back for better. Every paper this month is a rep toward the rank you want.",who:"Pradeep Singh (Indore) · AIR 26, CSE 2019",url:"https://www.business-standard.com/article/news-ani/indore-son-of-a-petrol-pump-worker-secures-upsc-rank-93-119040600810_1.html"},
 {t:"s",h:"Missed by one mark.",body:"Anu Kumari quit a nine-year corporate career and lived away from her young son for about two years to prepare. She missed the 2016 cut-off by a single mark, came back, and was AIR 2 in CSE 2017.",take:"One mark. She didn't read it as a verdict, and the next year she was second in India.",who:"Anu Kumari · AIR 2, CSE 2017",url:"https://www.thebetterindia.com/141326/harayana-anu-kumari-second-rank-holder-upsc/"},
 {t:"s",h:"From rank 849 to rank 1.",body:"Nandini K R failed prelims in her first attempt in 2013, then got AIR 849 and the IRS. She kept going and topped CSE 2016 in her fourth attempt.",take:"Where you stand today says nothing about where you finish.",who:"Nandini K R · AIR 1, CSE 2016",url:"https://www.oneindia.com/india/upsc-topper-kr-nandini-achieves-feat-on-her-fourth-attempt-2451131.html"},
 {t:"s",h:"She won at the CAT first.",body:"Ira Singhal was selected in 2010 but denied a service posting because of her disability. She took the government to the Central Administrative Tribunal, won, and then topped CSE 2014.",take:"A legal fight and the exam, side by side. You know both arenas, counsellor.",who:"Ira Singhal · AIR 1, CSE 2014",url:"https://indianmasterminds.com/feature-stories-on-bureaucrats-changemakers/from-rejection-to-recognition-legal-battles-of-civil-servants-with-disability-91193/"},
 {t:"s",h:"Left Hong Kong. Got IPS. Went for AIR 1.",body:"Gaurav Agarwal quit a trading job at Citigroup in Hong Kong, got AIR 244 and the IPS in 2012, and topped CSE 2013 the next year.",take:"He aimed higher while already in. Ambition and a full schedule can coexist.",who:"Gaurav Agarwal · AIR 1, CSE 2013",url:"https://www.dnaindia.com/education/report-meet-ias-gaurav-agrawal-iit-iim-alumnus-who-cracked-upsc-exam-twice-with-air-1-civil-services-exam-cse-3042856"},
 {t:"s",h:"Six failures. Waiting tables.",body:"K Jayaganesh worked as a waiter in Chennai to pay for coaching and failed the exam six times. In his seventh attempt, in 2008, he got AIR 156.",take:"Whatever today felt like, it isn't a seventh attempt. Show up for the next block.",who:"K Jayaganesh · AIR 156, CSE 2008",url:"https://thebetterindia.com/159961/ias-hero-exam-tamil-nadu-jayaganesh"},
 {t:"s",h:"Thrown out at 11. AIR 48 at 22.",body:"Govind Jaiswal, a Varanasi rickshaw puller's son, was insulted and thrown out of a rich friend's house at eleven. In Delhi he tutored maths to cover costs, and he got AIR 48 in his first attempt, in 2006.",take:"Use the sting. A bad result can be fuel instead of a brake.",who:"Govind Jaiswal · AIR 48, CSE 2006",url:"https://byjus.com/free-ias-prep/how-a-rickshaw-puller-son-become-ias-officer"},
 {t:"s",h:"12th fail. Three UPSC failures.",body:"Manoj Kumar Sharma failed class 12 and drove a tempo. He failed the civil services exam three times, got AIR 121 and the IPS on his fourth, and rose to Inspector General.",take:"One bad week doesn't write your story. He had three bad years.",who:"Manoj Kumar Sharma · AIR 121, IPS",url:"https://en.wikipedia.org/wiki/Manoj_Kumar_Sharma"}];
const L_SC=[
 {t:"c",h:"Why your best days come right before a paper",body:"The goal-gradient effect: people speed up as a goal gets closer. Coffee-card customers bought faster the nearer they were to a free drink.",take:"Bring the goal closer every day: end each day with two timed answers.",who:"Kivetz, Urminsky & Zheng (2006), Journal of Marketing Research"},
 {t:"c",h:"Why 'two hours for this topic' always lies",body:"The planning fallacy: people underestimate how long tasks will take, even when they know similar tasks ran over before.",take:"Estimate from what the last similar topic actually took you, then add a buffer.",who:"Buehler, Griffin & Ross (1994), Journal of Personality and Social Psychology"},
 {t:"c",h:"Close the notes. Then write.",body:"Students who practised recalling a text remembered far more a week later than students who reread it, even though rereading felt more effective.",take:"After each topic, write five points from memory before you look again.",who:"Roediger & Karpicke (2006), Psychological Science"},
 {t:"c",h:"Ten minutes tomorrow beats an hour today",body:"Spacing reviews over days produces better long-term memory than spending the same time in one sitting; a review of hundreds of experiments confirms it.",take:"Open each day with 10 minutes on yesterday's topic.",who:"Cepeda et al. (2006), Psychological Bulletin"},
 {t:"c",h:"If X, then Y",body:"Across 94 tests, people who made 'if this happens, I will do that' plans reached their goals far more often: a medium-to-large effect.",take:"Write one if-then for your weakest moment today, like 'If I reach for my phone after lunch, it goes to the other room.'",who:"Gollwitzer & Sheeran (2006), Advances in Experimental Social Psychology"},
 {t:"c",h:"One quick check costs more than you think",body:"After switching tasks, part of your attention stays stuck on the previous one, and performance on the next task drops. Researchers call it attention residue.",take:"Phone in another room for the whole block, not face-down beside you.",who:"Sophie Leroy (2009), Organizational Behavior and Human Decision Processes"},
 {t:"c",h:"Fresh starts are real",body:"People are more likely to start pursuing their goals right after temporal landmarks: a new week, a new month, a birthday.",take:"Treat the morning after each paper as a landmark: a clean start, not a recovery day.",who:"Dai, Milkman & Riis (2014), Management Science"},
 {t:"c",h:"Kindness makes you work harder",body:"After failing a test, people prompted to be self-compassionate studied longer for a retest than people prompted to boost their self-esteem.",take:"After a rough day, talk to yourself the way you'd talk to a friend who's preparing. Then do the next block.",who:"Breines & Chen (2012), Personality and Social Psychology Bulletin"},
 {t:"c",h:"The 'what the hell' effect",body:"Dieters who believed they'd already broken their diet went on to eat more than those who hadn't. A slip becomes a lost day only through the story you tell about it.",take:"A slip costs one block, not one day. The next block is the comeback.",who:"Herman & Mack (1975), Journal of Personality"},
 {t:"c",h:"Habits take about two months, and forgive a miss",body:"In a study of real habits, it took a median of 66 days for a new behaviour to become automatic, and missing a single day didn't derail it.",take:"You're building a habit, not a streak. Miss once, never twice.",who:"Lally et al. (2010), European Journal of Social Psychology"},
 {t:"c",h:"Move before the hard block",body:"A meta-analysis found that a single bout of exercise gives a small boost to cognitive performance afterwards.",take:"Ten minutes of brisk walking or a few hoops before your hardest block.",who:"Chang et al. (2012), Brain Research"},
 {t:"c",h:"Urges are waves",body:"Cravings rise, peak and fall away if you watch them without acting. Mindfulness-based relapse prevention trains exactly this; it's called urge surfing.",take:"When an urge hits, change rooms and ride it out. It crests and passes.",who:"Bowen & Marlatt (2009), Psychology of Addictive Behaviors"},
 {t:"c",h:"What you generate, you keep",body:"People remember words they generate themselves better than words they simply read: the generation effect.",take:"Write intros and conclusions in your own words. They'll come back to you in the exam hall.",who:"Slamecka & Graf (1978), Journal of Experimental Psychology"},
 {t:"c",h:"If it feels hard, it's working",body:"Testing, spacing and mixing topics feel slower and harder than rereading, but they produce learning that lasts. Bjork calls them desirable difficulties.",take:"Struggling through an answer beats gliding through a chapter.",who:"Robert Bjork (1994)"},
 {t:"c",h:"Why scrolling pulls and reading doesn't",body:"Dopamine neurons fire most for unexpected rewards and the cues that predict them. Feeds are built on unpredictability; a textbook isn't.",take:"Don't fight the pull with willpower. Remove the cue: phone out of the room.",who:"Schultz, Dayan & Montague (1997), Science"},
 {t:"c",h:"Deadlines you set yourself work",body:"Students who set their own deadlines did better than those given none, and evenly spaced deadlines worked best of all.",take:"Your paper dates are your spaced deadlines. Keep them fixed and they'll carry you.",who:"Ariely & Wertenbroch (2002), Psychological Science"},
 {t:"c",h:"Write the fear out before the paper",body:"Students who spent 10 minutes writing about their worries just before a high-pressure exam scored higher than those who didn't.",take:"Before each paper: 10 minutes, every worry on paper. Then pick up the pen.",who:"Ramirez & Beilock (2011), Science"},
 {t:"c",h:"Say 'I'm excited'",body:"People who told themselves 'I am excited' before a stressful performance did better than those who tried to calm down.",take:"Paper day: same racing heart, better label. 'I'm excited.'",who:"Alison Wood Brooks (2014), Journal of Experimental Psychology: General"},
 {t:"c",h:"Progress is the fuel",body:"In about 12,000 daily diary entries, making progress in meaningful work was the strongest boost to people's motivation and mood.",take:"Log what you covered, not just hours. Seeing progress powers tomorrow.",who:"Amabile & Kramer (2011), The Progress Principle"}];
const L_GB=[
 {t:"g",gm:"ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥",tr:"Ik Oankaar, Sat Naam, Kartaa Purakh, Nirbhau, Nirvair, Akaal Moorat, Ajoonee, Saibhan, Gur Prasaad",mn:"One Creator, whose name is Truth, the creative being, without fear, without hate, timeless, unborn, self-existent, known by the Guru's grace.",take:"Nirbhau: without fear. Recite it before you pick up the pen.",src:"Mool Mantar, Japji Sahib"},
 {t:"g",gm:"ਆਪੇ ਬੀਜਿ ਆਪੇ ਹੀ ਖਾਹੁ ॥",tr:"Aape beej aape hee khaahu",mn:"You sow, and you yourself eat what grows.",take:"Today's hours are the seeds. The paper is the harvest.",src:"Japji Sahib, Pauri 20"},
 {t:"g",gm:"ਖੇਤੁ ਜੁ ਮਾਂਡਿਓ ਸੂਰਮਾ ਅਬ ਜੂਝਨ ਕੋ ਦਾਉ ॥",tr:"Khet ju maandio soormaa ab joojhan ko daao",mn:"The battlefield is set, O warrior; now is the time to fight.",take:"You've prepared. When the paper starts, fight.",src:"Bhagat Kabir, Ang 1105"},
 {t:"g",gm:"ਸੋਚੈ ਸੋਚਿ ਨ ਹੋਵਈ ਜੇ ਸੋਚੀ ਲਖ ਵਾਰ ॥",tr:"Sochai soch na hovaee je sochee lakh vaar",mn:"Thinking does not get you there, even if you think a hundred thousand times.",take:"Thinking about studying isn't studying. Open the first page.",src:"Japji Sahib, Pauri 1"},
 {t:"g",gm:"ਉਦਮੁ ਕਰੇਦਿਆ ਜੀਉ ਤੂੰ ਕਮਾਵਦਿਆ ਸੁਖ ਭੁੰਚੁ ॥",tr:"Udam karediaa jeeo toon kamaavdiaa sukh bhunch",mn:"Make the effort and truly live; earning through it, enjoy peace.",take:"Peace comes after the effort, not before it. Start.",src:"Guru Arjan Dev Ji, Ang 522"},
 {t:"g",gm:"ਮਨਿ ਜੀਤੈ ਜਗੁ ਜੀਤੁ ॥",tr:"Man jeetai jag jeet",mn:"Conquer the mind and you conquer the world.",take:"Every urge you ride out is the mind conquered, one more time.",src:"Japji Sahib, Pauri 28"},
 {t:"g",gm:"ਦੇਹ ਸਿਵਾ ਬਰੁ ਮੋਹਿ ਇਹੈ ਸੁਭ ਕਰਮਨ ਤੇ ਕਬਹੂੰ ਨ ਟਰੋਂ ॥",tr:"Deh Shiva bar mohe ihai, subh karman te kabhoon na taron",mn:"Grant me this boon: that I never turn back from righteous deeds.",take:"Ask for one thing today: never to turn back from the work.",src:"Guru Gobind Singh Ji, Dasam Granth"},
 {t:"g",gm:"ਹੁਕਮਿ ਰਜਾਈ ਚਲਣਾ ਨਾਨਕ ਲਿਖਿਆ ਨਾਲਿ ॥",tr:"Hukam rajaaee chalnaa Nanak likhiaa naal",mn:"Walk in the way of His command and will, says Nanak.",take:"Do your part fully and leave the result to Him. That frees you to write.",src:"Japji Sahib, Pauri 1"},
 {t:"g",gm:"ਨ ਡਰੋਂ ਅਰਿ ਸੋ ਜਬ ਜਾਇ ਲਰੋਂ ਨਿਸਚੈ ਕਰਿ ਅਪੁਨੀ ਜੀਤ ਕਰੋਂ ॥",tr:"Na daron ar so jab jaae laron, nischai kar apunee jeet karon",mn:"When I go to fight, I fear no enemy; with certainty I make my victory.",take:"Walk into the paper with nischa: certainty, not hope.",src:"Guru Gobind Singh Ji, Dasam Granth"},
 {t:"g",gm:"ਸਚਹੁ ਓਰੈ ਸਭੁ ਕੋ ਉਪਰਿ ਸਚੁ ਆਚਾਰੁ ॥",tr:"Sachahu orai sabh ko upar sach aachaar",mn:"Truth is above everything, but higher still is truthful living.",take:"The plan is the truth; living it is higher. Do the next block.",src:"Sri Raag, Ang 62"},
 {t:"g",gm:"ਮਿਠਤੁ ਨੀਵੀ ਨਾਨਕਾ ਗੁਣ ਚੰਗਿਆਈਆ ਤਤੁ ॥",tr:"Mithat neevee Nanakaa gun changiaaeeaa tat",mn:"Sweetness and humility are the essence of all virtue and goodness.",take:"After a slip, humility, not shame. Then back to the desk.",src:"Asa di Vaar, Ang 470"},
 {t:"g",gm:"ਮਨ ਤੂੰ ਜੋਤਿ ਸਰੂਪੁ ਹੈ ਆਪਣਾ ਮੂਲੁ ਪਛਾਣੁ ॥",tr:"Man toon jot saroop hai, aapnaa mool pachhaan",mn:"O mind, you are the embodiment of light; recognise your origin.",take:"You are not your worst day. Remember who you are.",src:"Raag Aasa, Ang 441"},
 {t:"g",gm:"ਜਿਨਿ ਸੇਵਿਆ ਤਿਨਿ ਪਾਇਆ ਮਾਨੁ ॥",tr:"Jin seviaa tin paaiaa maan",mn:"Those who serve Him are honoured.",take:"Serve the work today. The honour follows.",src:"Japji Sahib, Pauri 5"},
 {t:"g",gm:"ਘਾਲਿ ਖਾਇ ਕਿਛੁ ਹਥਹੁ ਦੇਇ ॥",tr:"Ghaal khaae kichh hathhu dey",mn:"One who earns by honest effort and gives some of it away.",take:"Honest hours only. Earn the day.",src:"Sarang ki Vaar, Ang 1245"},
 {t:"g",gm:"ਸਭਨਾ ਜੀਆ ਕਾ ਇਕੁ ਦਾਤਾ ਸੋ ਮੈ ਵਿਸਰਿ ਨ ਜਾਈ ॥",tr:"Sabhnaa jeeaa kaa ik daataa so mai visar na jaaee",mn:"There is one Giver of all beings; may I never forget Him.",take:"You're not alone at the desk. Remember the Giver, then work.",src:"Japji Sahib, Pauri 5"}];
const L_HS=[
 {t:"s",h:"Ninth, when there were eight places.",body:"A P J Abdul Kalam dreamed of flying fighter jets. At the Indian Air Force selection he finished ninth when there were eight places. He went on to lead India's missile programme and became President.",take:"A missed list can point to a bigger door. Your PCS result isn't the end of the corridor.",who:"A P J Abdul Kalam · Wings of Fire"},
 {t:"s",h:"A refugee boy. A fraction of a second.",body:"Milkha Singh lost his parents in the violence of Partition and arrived in India as a refugee boy. At the 1960 Rome Olympics he missed a 400 m medal by a fraction of a second, kept racing, and became the Flying Sikh.",take:"The near-miss became part of the legend, not the end of it.",who:"Milkha Singh"},
 {t:"s",h:"Made to sit apart. Drafted the Constitution.",body:"As a boy, B R Ambedkar was made to sit apart at school and couldn't drink from the common tap. He earned doctorates from Columbia and the London School of Economics, became a barrister, and chaired the drafting of the Constitution you now write answers on.",take:"A lawyer who studied his way past every barrier. That's your lineage at the desk.",who:"B R Ambedkar"},
 {t:"s",h:"A law degree from a prison cell.",body:"Nelson Mandela kept studying through his 27 years in prison and completed his law degree by correspondence from the University of South Africa in 1989, months before his release.",take:"If a law degree can be finished from a cell, a GS paper can be finished from your desk.",who:"Nelson Mandela"},
 {t:"s",h:"Thrown off a train at Pietermaritzburg.",body:"In 1893 a young lawyer named M K Gandhi was thrown off a first-class train at Pietermaritzburg. He later described that cold night on the platform as a turning point of his life.",take:"One humiliating night can be the start of the work that defines you.",who:"M K Gandhi"},
 {t:"s",h:"He lost, and lost, and lost.",body:"Abraham Lincoln lost a race for the Illinois legislature, lost two contests for the US Senate and lost a bid for the vice-presidential nomination before he was elected President in 1860.",take:"Count his losses and you'd have written him off. Count your 8–10 hour days instead.",who:"Abraham Lincoln"},
 {t:"s",h:"Written off for a decade.",body:"Through most of the 1930s Winston Churchill was out of office, dismissed as finished, his warnings ignored. In 1940, at 65, he became Prime Minister.",take:"Being written off is a phase, not a verdict.",who:"Winston Churchill"},
 {t:"s",h:"Reading to the very end.",body:"In jail, Bhagat Singh read relentlessly and filled a notebook with notes and quotations from more than a hundred writers, studying right up to the end.",take:"Fierce focus on the page under pressure is a Punjabi inheritance. Claim it.",who:"Bhagat Singh · the jail notebook"},
 {t:"s",h:"Twins, then an Olympic medal.",body:"After becoming a mother of twins, M C Mary Kom came back to boxing, won more world titles, and took bronze at the 2012 London Olympics.",take:"Life outside the ring didn't end her career; structure around it carried her. Same for your basketball and friends.",who:"Mary Kom"},
 {t:"s",h:"Surgery, a lost season, then gold.",body:"Neeraj Chopra took up sport as an overweight boy trying to get fit. In 2019 he had elbow surgery and lost most of a season, then won Olympic gold in Tokyo.",take:"A lost stretch isn't a lost season. Rehab, then gold.",who:"Neeraj Chopra"},
 {t:"s",h:"Tickets by day, cricket around the shifts.",body:"Before he played for India, M S Dhoni worked as a ticket collector at Kharagpur railway station and fitted cricket around his shifts.",take:"He fitted the dream around a job. You have whole days for yours.",who:"M S Dhoni"},
 {t:"s",h:"Seventh in Athens. Gold in Beijing.",body:"Abhinav Bindra finished seventh at the 2004 Athens Olympics. Four years later in Beijing he won India's first individual Olympic gold.",take:"A disappointing result can be the first draft of the winning one.",who:"Abhinav Bindra"},
 {t:"s",h:"An emperor talking himself back to work.",body:"Marcus Aurelius wrote the private notes we call Meditations, often while on campaign, reminding himself again and again to get up and do the work in front of him.",take:"Even an emperor had to talk himself back to the task. That's all SOS is.",who:"Marcus Aurelius · Meditations"},
 {t:"s",h:"Fired from his own company.",body:"In 1985 Steve Jobs was forced out of Apple, the company he had co-founded. He returned in 1997 and led its revival, and later said being fired was one of the best things that ever happened to him.",take:"A setback can reset you for something better. PCS mains might be that reset.",who:"Steve Jobs"},
 {t:"s",h:"One eye, a teenager, Lahore.",body:"Ranjit Singh lost the sight of one eye to smallpox as a child, and was still a teenager when he took Lahore in 1799. He went on to build the Sikh Empire.",take:"Start young, start imperfect, start anyway.",who:"Maharaja Ranjit Singh"},
 {t:"s",h:"Player of the Tournament, then chemo.",body:"Yuvraj Singh was Player of the Tournament at the 2011 World Cup while unwell; soon after, he was diagnosed with a rare cancer, went through chemotherapy, and came back to play for India again.",take:"He played through what he didn't yet understand. You know exactly what you're up against; that's an advantage.",who:"Yuvraj Singh"},
 {t:"s",h:"Brilliant at one thing, failed the rest.",body:"Srinivasa Ramanujan lost his college scholarship because he neglected every subject except mathematics. Years later a letter to G H Hardy took him to Cambridge.",take:"Use your strength, but don't let it carry the rest: S&T can't cover for environment.",who:"Srinivasa Ramanujan"}];
const LIFT=(()=>{const L=[L_ST,L_HS,L_SC,L_GB],o=[],n=Math.max(...L.map(x=>x.length));for(let i=0;i<n;i++)L.forEach(x=>{if(x[i])o.push(x[i])});return o})();
const LIFT0="2026-11-23";
function thoughtCard(d,p,T){
  const pt=patternFor(d),n=LIFT.length,k=((diff(LIFT0,d)%n)+n)%n,c=LIFT[k];
  const box=el("aside",{class:"thought","aria-label":"Thought for the day"},el("p",{class:"pat"},pt.pat));
  if(c.t==="g")box.append(el("p",{class:"gm",lang:"pa"},c.gm),el("p",{class:"tr"},c.tr),el("p",{class:"mn"},c.mn),el("p",{class:"do"},el("b",{},"For you: "),c.take),el("p",{class:"src"},c.src));
  else box.append(el("p",{class:"tr"},el("b",{},c.h)),el("p",{class:"mn"},c.body),el("p",{class:"do"},el("b",{},"For you: "),c.take),el("p",{class:"src"},c.who,c.url?[" · ",el("a",{href:c.url,target:"_blank",rel:"noopener"},"source")]:null));
  box.append(el("p",{class:"do"},el("b",{},"Today: "),pt.do));
  return box;
}

function renderNow(){
  const box=$("nowline");if(!box)return;box.textContent="";
  const d=todayIST();if(d<START||d>END||!TS){box.hidden=true;return}box.hidden=false;
  const T=TS,p=dayPlan(d,T),l=logs[d]||{},mins=nowMins();
  const put=(tag,txt,pct)=>{box.append(el("span",{class:"htag"},tag),el("span",{class:"htxt"},txt));if(pct!=null)box.append(el("span",{class:"hbar2"},el("i",{style:"width:"+Math.round(pct*100)+"%"})))};
  if(!p.segs){put("Today",shortKind(p,d));return}
  if(l.stopAt!=null&&mins>=l.stopAt){put("Stopped","Rest. The work has moved forward.");return}
  if(!p.start.set&&mins>=p.start.s-30&&mins<1260){put("Not started","Tap Plan my day below.");return}
  if(mins<p.start.s){put("Early","Your day starts at "+hm(p.start.s)+".");return}
  const all=p.segs.concat([{k:"break",t:p.lights,e:null,label:"Lights out"}]);
  const i=all.findIndex(s=>mins>=s.t&&mins<(s.e??s.t+30));
  if(i<0){const tm=add(d,1);put("Night",mins>=p.lights?"Lights out. Tomorrow starts at "+hm(tm<=END?dayPlan(tm,T).start.s:300)+".":"Between blocks.");return}
  const s=all[i],end=s.e??s.t+30,nx=all[i+1];
  put("Now",(s.name||s.label)+" · "+(end-mins)+" min left"+(nx?" · then "+(nx.name||nx.label)+" at "+hmS(nx.t):""),Math.max(0,Math.min(1,(mins-s.t)/(end-s.t))));
}

