const R=(a,b)=>Array.from({length:b-a+1},(_,i)=>String(a+i));
const S=a=>a.map(String);
const TOPICS={ST3:R(1,10),ST4:R(11,20),ST5:S([1,2,4,5,8]),ST6:S([3,6,7,8]),ST2:S([10]).concat(R(12,20)),F1:R(1,8),F2:R(1,20),F3:R(1,20),F4:R(1,8)};
const GS={
 gs1:{1:"Art and culture: art forms, literature, architecture",2:"Modern Indian history from the mid-18th century; freedom struggle",3:"Post-independence consolidation and reorganisation",4:"World history from the 18th century",5:"Indian society: diversity, women, population, poverty, urbanisation, globalisation, empowerment, communalism, regionalism, secularism",6:"Physical geography of the world",7:"Distribution of natural resources; location of industries",8:"Geophysical phenomena; changes in geographical features"},
 gs2:{1:"Constitution: evolution, features, amendments, basic structure",2:"Union and States: federal issues, devolution to local levels",3:"Separation of powers; dispute-redressal mechanisms",4:"Indian constitutional scheme vs other countries",5:"Parliament and State Legislatures",6:"Executive and Judiciary; ministries; pressure groups",7:"Representation of the People Act",8:"Constitutional posts and bodies",9:"Statutory, regulatory and quasi-judicial bodies",10:"Government policies and interventions; design and implementation issues",11:"Development processes: NGOs, SHGs, donors",12:"Welfare schemes for vulnerable sections; protective laws and bodies",13:"Social sector: health, education, human resources",14:"Poverty and hunger",15:"Governance, transparency, accountability; e-governance; citizens' charters",16:"Role of civil services in a democracy",17:"India and its neighbourhood",18:"Bilateral, regional and global groupings and agreements",19:"Other countries' policies and India's interests; diaspora",20:"International institutions, agencies and fora"},
 gs3:{1:"Economy: planning, resources, growth, development, employment",2:"Inclusive growth",3:"Government budgeting",4:"Crops, cropping patterns, irrigation, farm marketing, e-tech for farmers",5:"Farm subsidies, MSP, PDS, buffer stocks, food security; animal rearing",6:"Food processing industries",7:"Land reforms",8:"Liberalisation; industrial policy and growth",9:"Infrastructure: energy, ports, roads, airports, railways",10:"Investment models",11:"S&T developments in everyday life",12:"Indian achievements in S&T; indigenisation",13:"IT, space, computers, robotics, nano, biotech; IPR",14:"Conservation, pollution, EIA",15:"Disasters and disaster management",16:"Development and the spread of extremism",17:"External state and non-state actors in internal security",18:"Communication networks, social media, cyber security, money laundering",19:"Border security; organised crime and terrorism",20:"Security forces and agencies"},
 gs4:{1:"Ethics and human interface; human values",2:"Attitude: content, structure, function; persuasion",3:"Aptitude and foundational values for civil service",4:"Emotional intelligence",5:"Moral thinkers and philosophers",6:"Civil service values; ethical dilemmas; accountability; corporate governance",7:"Probity: RTI, codes, citizens' charters, public funds, corruption",8:"Case studies"}};
const LAW=[
 {s:"Contracts",items:["Quasi contracts (in progress)","Consequences of breach","Indemnity, guarantee and insurance","Agency","Sale of goods and hire purchase","Formation and dissolution of partnerships","Negotiable Instruments Act","Standard form contracts"]},
 {s:"Torts",items:["Nature of tortious liability","Fault-based and strict liability","Absolute liability","Vicarious liability, including State liability","General defences","Joint tortfeasors","Remedies","Negligence","Defamation","Nuisance","Conspiracy","False imprisonment","Malicious prosecution","Consumer protection law"]},
 {s:"Contemporary",items:["Public interest litigation","IPR: copyright, patents, trademarks, designs","IT law and cyber laws","Competition law","Alternate dispute resolution","Major environmental statutes","Right to Information Act","Trial by media"]},
 {s:"Crimes",items:["General principles of criminal liability: mens rea, actus reus","Preparation and criminal attempt","General exceptions","Joint and constructive liability","Abetment","Criminal conspiracy","Offences against the State","Offences against public tranquillity","Offences against the human body","Offences against property","Offences against women","Criminal defamation","Prevention of Corruption Act, 1988","Protection of Civil Rights Act, 1955","Plea bargaining"]}];

const lawKey=(i,j)=>LAW[i].s.toLowerCase()+"-"+j;
const LAW_TOTAL=LAW.reduce((s,g)=>s+g.items.length,0);
function lawLeft(){let n=0;LAW.forEach((g,i)=>g.items.forEach((_,j)=>{if(!(plan.law||{})[lawKey(i,j)])n++}));return n}
function nextLaw(){for(let i=0;i<LAW.length;i++)for(let j=0;j<LAW[i].items.length;j++)if(!(plan.law||{})[lawKey(i,j)])return LAW[i].s+": "+LAW[i].items[j];return null}
const taskDone=id=>!!(plan.tasks||{})[id];
const CA_STAGES=[["vision","Vision May notes","2026-11-30"],["ca-june","June (Vision, plus the Factly index for species and places)","2026-12-15"],["ca-july","July","2026-12-31"],["ca-aug","August (Factly)","2027-01-15"]];
function caStage(){return CA_STAGES.find(s=>!taskDone(s[0]))||null}
/* spare days: a slipped test lands here; if nothing slipped, the day is prep for the next test */
