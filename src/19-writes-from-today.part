/* ---------- writes from Today ---------- */
function patchLog(d,patch){
  const before=dayHours(d)||0;
  docState("logs/"+d,logs[d]);
  const lg=Object.assign({},logs[d]||{});Object.keys(patch).forEach(k=>{if(patch[k]==null)delete lg[k];else lg[k]=patch[k]});
  lg.savedAt=Date.now();logs[d]=lg;saveLocal();
  saveDoc("logs/"+d,lg);
  render();
  const after=dayHours(d)||0;
  const tier=[RULES.treatH,RULES.prizeH,RULES.rewardH].findIndex(H=>before<H&&after>=H);
  if(tier>=0)setTimeout(()=>showReward(d,2-tier),120);
}
