/* ---------- the day planner: questions in, a timetable out, changes in plain words ---------- */
let SAMPLE;
const BOOK0=`Wake and sleep
- Breakfast with the newspaper is at 10:00, about 1 hour (30 min on heavy days). If I wake after 9:30, breakfast and newspaper come first.
- Lights out is the time I give today; normally about 10 pm.
- After a short night (under 6 h), add a 60–90 min sleep after lunch only if I ask for it.

Gurbani
- 30 min, first thing after waking. If I say it's done, leave it out. If a late wake pushes it out, put it around 6:30 pm.

Gym
- Walk and gym, 1 h, around 9:00–10:00, only if I've had about 2 h of study before it. Woke 6:16–7:00: gym at 9:05. Woke 7–8: no morning gym; a 50-min home workout before the afternoon shower. Woke later: no gym unless I ask.

Study blocks and breaks
- Study blocks of 1.5–2.5 h. Never two long blocks back to back; breaks are 10–30 min and boring (no phone).
- Shower and fruit in the afternoon, around 3–4 pm.
- Dinner, a short walk and phone around 7–8 pm (40–60 min), then an evening study session.
- I crash around 5–6 pm unless the day has some rest; on long days put a rest or short sleep in the early afternoon.

Test days
- Revise the test's topics in the blocks before the paper. The paper slot is exactly 3 h (one essay: 90 min; two essays: 3 h) at the time I give; default 2:30 pm. No gym unless I ask. Rest before an afternoon paper.
- After the paper: a 10–30 min break, then CA or Law, then the next test's topics.

Essay days
- Normal blocks; take about 2 h of them for essay research, then the essay.

What goes in the blocks
- The next test's open topics first, then CA notes (30 min a day), then Law Optional (45 min a day once it has started).
- Never schedule uploading copies or "log the day".

How hard
- Normal: about 9–10 h of study. Hard: 10–12 h. Max: as much as fits, with short breaks but never none.`;
const bookText=()=>(plan.book&&plan.book.trim())||BOOK0;
const aiOf=l=>l&&l.ai&&Array.isArray(l.ai.segs)&&l.ai.segs.length?l.ai:null;
/* A saved timetable (Plan my day or Build my day) can outlive a test move. A paper slot on a day whose paper has moved
   becomes study time, so the timetable, the Now line and every later change follow the Tests tab, not the old plan. */
function paperIsStale(label,d,T){const tt=testOn(d,T);if(!tt)return true;
  const named=T.find(t=>t.id!==tt.id&&String(label||"").includes(t.name.split(" · ")[0]));return !!named&&named.date!==d}
function movedNote(label,T){const t=T.find(x=>String(label||"").includes(x.name.split(" · ")[0]));return t?t.name.split(" · ")[0]+(t.skipped?" skipped":" moved to "+short(t.date)):"no paper today"}
function aiLive(ai,d,T){if(!ai)return ai;let ch=false;
  const segs=ai.segs.map(s=>{if(s.type!=="paper"||!paperIsStale(s.label,d,T))return s;ch=true;return Object.assign({},s,{type:"study",label:"Study block",note:"",was:"was the paper slot: "+movedNote(s.label,T)})});
  return ch?Object.assign({},ai,{segs}):ai}
function customLive(b,d,T){if(testOn(d,T))return b;b.segs=b.segs.map(s=>s.role==="paper"?Object.assign({},s,{role:"study",name:"Study block",hint:"was the paper slot: no paper today"}):s);return b}
function aiSegs(ai){return ai.segs.map(s=>s.type==="break"?{k:"break",t:s.t,e:s.e,label:s.label,id:s.id,hint:s.note}:{k:"block",t:s.t,e:s.e,role:s.type==="paper"?"paper":s.type==="news"?"news":"study",name:s.label,id:s.id,hint:s.note,was:s.was})}
/* back from the page's slot shape to the Plan-my-day shape, for changes written into the plan itself */
function segToAi(s){const brk=s.k==="break";return{id:s.id,t:s.t,e:s.e,label:brk?s.label:s.name,type:brk?"break":s.role==="paper"?"paper":s.role==="news"?"news":"study",note:s.was?"":s.hint||""}}
const isWork=s=>s.type!=="break";
const parseHM=v=>{const m=/(\d{1,2})[:.](\d{2})/.exec(String(v||""));return m?(+m[1])*60+(+m[2]):null};
const t24=m=>{m=((Math.round(m)%1440)+1440)%1440;return String(Math.floor(m/60)).padStart(2,"0")+":"+String(m%60).padStart(2,"0")};
function aiContext(d){
  const T=TS,tt=testOn(d,T),pend=T.filter(t=>!t.done&&!t.opt),L=[];
  L.push("Date: "+nice(d));
  if(tt)L.push("Test today: "+tt.name+(tt.kind==="essay"?(tt.half?" (one essay, 90 min)":" (two essays, 3 h)"):" (3-hour paper)")+(tt.delhi?", at the Delhi centre":""));
  else L.push("No test or paper today: don't schedule one.");
  const nx=pend.filter(t=>t.date>d&&t.kind!=="essay")[0];
  if(nx){const tk=ticks(nx.id),dr=drops(nx.id),open=nx.topics.filter(n=>!tk[n]&&!dr[n]);
    L.push("Next GS test: "+nx.name+" on "+nice(nx.date)+" ("+diff(d,nx.date)+" days away). Open topics: "+(open.length?open.map(n=>n+" "+((GS[nx.kind]||{})[n]||"")).join("; "):"none"))}
  const ne=pend.find(t=>t.kind==="essay"&&t.date>d);if(ne)L.push("Next essay: "+ne.name+" on "+nice(ne.date));
  if(TRAVEL[d])L.push(TRAVEL[d]);
  const cs=caStage();if(cs)L.push("CA notes in progress: "+cs[1]+", due "+short(cs[2]));
  if(d>=RULES.lawFrom){const nl=nextLaw();if(nl)L.push("Law Optional has started. Next: "+nl)}else L.push("Law Optional starts "+short(RULES.lawFrom)+"; leave it out today.");
  return L.join("\n");
}
const OUT_SPEC=`Reply with JSON only, no prose:
{"lights":"HH:MM","slots":[{"id":"keep an existing id when you keep or move a slot; omit for new","start":"HH:MM","end":"HH:MM","label":"short label","type":"study|break|paper|news","note":"optional, under 8 words"}],"summary":"one short sentence on the shape of the day"}
- 24-hour times. Slots in order, no overlaps, and no gaps from the start to lights out, except time he asks to leave out.
- type: study = any study block. Label every study block exactly "Study block" with no note: Perry decides what to study in each, so never assign subjects or topics to blocks. news = breakfast and newspaper; paper = a test or essay being written; break = everything else (meals, Gurbani, gym, shower, sleep, rest).
- No "log the day" slot and no upload slot.`;
async function askAI(prompt){
  let s=SAMPLE;
  if(!s){const c=window.claude;s=c&&c.use?await c.use("sample"):null;SAMPLE=s}
  if(!s)throw{code:"not_granted"};
  return await s.json(prompt,{modelTier:"default",cache:false});
}
function cleanPlan(v,from,keep,old){
  if(!v||!Array.isArray(v.slots))throw{code:"bad_plan"};
  let segs=v.slots.map(x=>({t:parseHM(x.start),e:parseHM(x.end),label:String(x.label||"").trim().slice(0,60)||"Study",type:["study","break","paper","news"].includes(x.type)?x.type:"break",note:x.note?String(x.note).trim().slice(0,70):"",id:x.id?String(x.id):"",done:x.done===true||undefined,sm:x.studied_min!=null&&!isNaN(+x.studied_min)?Math.max(0,Math.round(+x.studied_min)):undefined})).filter(x=>x.t!=null&&x.e!=null);
  segs.forEach(x=>{if(x.t<from-180)x.t+=1440;if(x.e<=x.t)x.e+=1440});
  if(old){const used=new Set(segs.map(x=>x.id).filter(Boolean));segs.forEach(x=>{if(x.id)return;const m=old.find(o=>!used.has(o.id)&&o.label===x.label&&o.t===x.t)||old.find(o=>!used.has(o.id)&&o.label===x.label);if(m){x.id=m.id;used.add(m.id)}})}
  if(keep&&keep.length){const cut=keep[keep.length-1].e;segs=keep.concat(segs.filter(x=>x.e>cut).map(x=>Object.assign(x,{t:Math.max(x.t,cut)})))}
  segs.sort((a,b)=>a.t-b.t);
  const out=[],seen=new Set();
  segs.forEach(x=>{const p=out[out.length-1];if(p&&x.t<p.e)x.t=p.e;if(x.e-x.t<5)return;if(!x.id||seen.has(x.id))x.id="s"+Math.random().toString(36).slice(2,8);seen.add(x.id);out.push(x)});
  if(!out.length)throw{code:"bad_plan"};
  let lights=parseHM(v.lights);if(lights==null)lights=out[out.length-1].e;if(lights<from-180)lights+=1440;
  lights=Math.max(lights,out[out.length-1].e);
  return{segs:out,lights,summary:String(v.summary||"").slice(0,200)};
}
const aiErr=e=>e&&e.code==="not_granted"?"Planning isn't available in this view of the page.":e&&e.code==="rate_limited"?"Too many requests just now. Try again in a minute.":e&&e.code==="bad_plan"?"That plan came back garbled. Try again.":"Couldn't plan right now. Check your connection and try again.";
let aiBusy={},aiAsk={},aiDraft={};
function suggestions(d){
  const T=TS,tt=testOn(d,T),pend=T.filter(t=>!t.done&&!t.opt),out=[];
  if(tt)out.push("Write "+tt.name.split(" · ")[0]+(tt.kind==="essay"?"":", revise before it"));
  const nx=pend.filter(t=>t.date>d&&t.kind!=="essay")[0];
  if(nx)out.push("Prep "+nx.name.replace(" topics "," "));
  const ne=pend.find(t=>t.kind==="essay"&&t.date===add(d,1));if(ne)out.push("Essay research for tomorrow");
  if(caStage())out.push("CA notes catch-up");
  if(d>=RULES.lawFrom&&nextLaw())out.push("Law Optional");
  return out.slice(0,5);
}
function askCard(d,T,l){
  const a=Object.assign({about:[],push:"normal",fixed:"",more:""},(aiOf(l)||{}).answers||{},aiDraft[d]||{});
  const save=()=>{aiDraft[d]=a};
  const isT=d===todayIST();
  const wake=el("input",{type:"time",id:"aiWake",value:a.wake||toTime(l.start!=null?l.start:isT?Math.floor(nowMins()/5)*5:300),oninput:e=>{a.wake=e.target.value;save()}});
  const lights=el("input",{type:"time",id:"aiLights",value:a.lights||"22:00",oninput:e=>{a.lights=e.target.value;save()}});
  const chip=(txt,on,fn)=>el("button",{class:on?"primary":"",type:"button",onclick:fn},txt);
  const sug=suggestions(d);a.about=a.about.filter(x=>sug.includes(x));const aboutBox=el("div",{class:"chips"});
  const drawAbout=()=>{aboutBox.textContent="";sug.forEach(s=>aboutBox.append(chip(s,a.about.includes(s),()=>{a.about=a.about.includes(s)?a.about.filter(x=>x!==s):a.about.concat([s]);save();drawAbout()})))};drawAbout();
  const pushBox=el("div",{class:"chips"});
  const drawPush=()=>{pushBox.textContent="";[["normal","Normal"],["hard","Hard"],["max","Max"]].forEach(([k,t])=>pushBox.append(chip(t,a.push===k,()=>{a.push=k;save();drawPush()})))};drawPush();
  const more=el("input",{type:"text",id:"aiMore",value:a.more,placeholder:"Anything else about today",oninput:e=>{a.more=e.target.value;save()}});
  const fixed=el("textarea",{id:"aiFixed",rows:"2",placeholder:"Gurbani done, gym at 5, nap after lunch, paper at 8 am",oninput:e=>{a.fixed=e.target.value;save()}});fixed.value=a.fixed;
  const msg=el("p",{class:"note",style:"margin:0"});
  const go=el("button",{class:"accent big",onclick:async()=>{
    const from=fromTime(wake.value),lo=fromTime(lights.value);if(from==null||lo==null){msg.textContent="Set both times first.";return}
    a.wake=wake.value;a.lights=lights.value;
    go.disabled=true;go.textContent="Planning…";msg.textContent="This takes a few seconds.";
    const prompt="You plan one study day for Perry, a UPSC Mains aspirant in India. Follow his rules; his answers for today override them.\n\nHIS RULES:\n"+bookText()+"\n\nTODAY:\n"+aiContext(d)+"\n\nHIS ANSWERS:\nStarts at "+wake.value+" (that is the first slot's start).\nLights out at "+lights.value+".\nToday is about: "+(a.about.concat(a.more?[a.more]:[]).join("; ")||"use the context")+".\nHow hard: "+a.push+".\nFixed things and notes: "+(a.fixed||"none")+".\n\n"+OUT_SPEC;
    try{const v=await askAI(prompt);const c=cleanPlan(v,from);
      delete aiAsk[d];delete aiDraft[d];
      const prev=aiOf(l);
      patchLog(d,{ai:{segs:c.segs,lights:c.lights,summary:c.summary,answers:a,at:Date.now(),prev:prev?{segs:prev.segs,lights:prev.lights,summary:prev.summary||""}:null},start:l.start!=null?l.start:from,startHow:l.startHow||"ai",startAt:l.startAt||Date.now(),custom:null,slots:null,lightsAt:null});
    }catch(e){go.disabled=false;go.textContent="Plan my day";msg.textContent=aiErr(e)}
  }},"Plan my day");
  const q=(lab,...kids)=>el("div",{class:"field",style:"display:flex;flex-direction:column;gap:8px"},el("span",{class:"label"},lab),...kids);
  return el("section",{class:"work",style:"padding:14px;display:flex;flex-direction:column;gap:16px"},
    el("div",{style:"display:grid;grid-template-columns:1fr 1fr;gap:10px"},el("div",{style:"display:flex;flex-direction:column;gap:6px;min-width:0"},el("label",{class:"label",for:"aiWake"},isT?"Start":"Planned start"),wake),el("div",{style:"display:flex;flex-direction:column;gap:6px;min-width:0"},el("label",{class:"label",for:"aiLights"},"Lights out"),lights)),
    q("What's today about",aboutBox,more),
    q("How hard",pushBox),
    q("Anything fixed",fixed),
    el("div",{class:"row"},go,aiOf(l)?el("button",{onclick:()=>{delete aiAsk[d];renderDay(TS)}},"Cancel"):null),msg);
}
function workHours(seg){return (seg.e-seg.t)/60}
/* One timetable screen for every day, whichever way it was made. Tap a row to log what you covered or change its time. */
function timetableView(d,p,T,l,isToday,mins){
  const ai=p.src==="ai"?p.ai:null,B=l.blocks||{},sec=el("section",{class:"plan"});
  const planned=p.segs.filter(s=>s.k==="block").reduce((s,x)=>s+x.e-x.t,0),done=dayHours(d)||0;
  sec.append(el("div",{class:"section-h"},el("h3",{},"Timetable"),el("span",{class:"sumline"},"Planned ",el("b",{},dur(planned))," · done ",el("b",{},hrs(done)))));
  if(!ai&&!p.start.set)sec.append(el("p",{class:"note",style:"margin:0 0 8px"},"Model day from "+hm(p.start.s)+"."));
  const wasP=p.segs.find(s=>s.was);
  if(ai&&ai.summary&&!wasP)sec.append(el("p",{class:"note",style:"margin:0 0 8px"},ai.summary));
  if(wasP)sec.append(el("p",{class:"note",style:"margin:0 0 8px"},"The paper slot is now study time ("+wasP.was.replace("was the paper slot: ","")+")."));
  {const tt=testOn(d,T);if(tt&&!tt.written&&!tt.delhi&&p.src!=="rules"&&!p.segs.some(s=>s.role==="paper"))sec.append(el("div",{class:"banner",style:"margin:0 0 10px"},el("span",{},tt.name.split(" · ")[0]+" is on this day now, but this timetable has no paper slot."),canWrite&&d>=todayIST()?el("button",{class:"mini",onclick:()=>{aiAsk[d]=true;renderDay(TS)}},"Plan again"):null))}
  const tap=(node,fn,label)=>{if(!canWrite)return node;node.classList.add("tap");node.setAttribute("role","button");node.setAttribute("tabindex","0");node.setAttribute("aria-label",label);
    node.addEventListener("click",e=>{if(e.target.closest("button,input"))return;fn()});node.addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target===node)fn()});return node};
  const ul=el("ul",{class:"tt"}),noEve=!ai&&!p.segs.some(s=>s.k==="block"&&s.t>=1140);
  p.segs.forEach(s=>{const live=isToday&&mins>=s.t&&mins<s.e;
    if(s.k==="break"){
      const nm=el("span",{class:"nm"},s.label,s.edited?el("span",{class:"hint"}," · changed"):s.hint?el("span",{class:"hint"}," · "+s.hint):null);
      ul.append(tap(el("li",{class:"br"+(live?" live":"")},el("span",{class:"tm"},hmS(s.t)),nm,el("span")),()=>openSlotEdit(d,s),"Change "+s.label));
      if(noEve&&/^Dinner/.test(s.label)&&s.t<1260)ul.append(extraRow(d,B));
      return}
    ul.append(blockRow(d,s,B,l,live,tap,p.src))});
  ul.append(tap(el("li",{class:"br"},el("span",{class:"tm"},hmS(p.lights)),el("span",{class:"nm"},"Lights out",l.lightsAt!=null?el("span",{class:"hint"}," · changed"):null),el("span")),()=>openSlotEdit(d,{id:"__lights",t:p.lights,label:"Lights out"}),"Change lights out"));
  sec.append(ul);
  const extra=Object.entries(B).filter(([k])=>k!=="evening"&&!p.segs.some(s=>s.id===k));
  if(extra.length)sec.append(el("ul",{class:"loglist",style:"margin-top:10px"},extra.map(([k,r])=>logLi(d,k,r))));
  if(canWrite&&ai&&d>=todayIST()){
    const inp=el("input",{type:"text",id:"aiChange",placeholder:"studied 4:30–7:30 · make 3 to 4 a break · lights out 11"});
    const msg=el("p",{class:"note",style:"margin:6px 0 0"});
    const btn=el("button",{class:"primary",onclick:async()=>{
      const req=inp.value.trim();if(!req){msg.textContent="Type what to change first.";return}
      btn.disabled=true;btn.textContent="Changing…";msg.textContent="";
      const now=isToday?mins:0,keep=ai.segs.filter(s=>B[s.id]);
      const cur=ai.segs.map(s=>({id:s.id,start:t24(s.t),end:t24(s.e),label:s.label,type:s.type,note:s.note||undefined,done:!!B[s.id]||undefined}));
      const prompt="You adjust Perry's study plan for today. Make exactly the change he asks for and only what it forces; keep everything else as it is. Keep his rules where the change allows.\n\nHIS RULES:\n"+bookText()+"\n\nTODAY:\n"+aiContext(d)+"\n\nCURRENT PLAN (lights out "+t24(p.lights)+"):\n"+JSON.stringify(cur)+"\n\n"+(isToday?"It is now "+t24(now)+".\n":"")+"HOW TO APPLY THE CHANGE:\n- Do exactly what he asks. You may remove, move or replace any slot, including ones that already ended, except slots marked done:true: those stay exactly as they are.\n- If he gives a new window (for example 'from 4 pm to 12:15 am'), the replanned part runs from that start to that end, and lights out is that end. Times after midnight are fine (write 00:15).\n- Removed slots that already ended are simply left out; don't fill that time.\n- Slots he didn't mention that ended before now and aren't done: keep them as they are.\n- If he tells you what he actually did (for example 'studied 12:30 to 2, slept till 4:30, studied 4:30 to 7:30'), rewrite that part of the day to match what really happened, with his real times, and add \"done\":true to every study slot he says he actually studied. If he says he studied less than the slot (for example '2 h 30 min from 4:30 to 7:30'), also add \"studied_min\" with the minutes (150). Never mark a slot done that he didn't say he did. Then plan from the end of what he describes, or from now if that is later, to lights out.\n- Keep studying blocks labelled exactly \"Study block\".\n\nHIS CHANGE: "+req+"\n\n"+OUT_SPEC+"\n- In this reply, slots may also carry \"done\":true and \"studied_min\":number, as described above.";
      try{const v=await askAI(prompt);const c=cleanPlan(v,ai.segs[0].t,keep,ai.segs);
        /* study he says he actually did is logged straight onto those blocks */
        const nb=Object.assign({},B);let sn2=0,got=0;
        c.segs.forEach(s=>{if(s.type==="study")sn2++;if(s.done&&isWork(s)&&!nb[s.id]){const full=s.e-s.t,m=s.sm!=null?Math.min(s.sm,full+120):full;if(m>0){const nm=s.type==="study"?"Study block "+sn2:s.label;nb[s.id]={name:nm,what:nm,t:s.t,e:s.e,hours:m/60,at:Date.now()};got+=m}}delete s.done;delete s.sm});
        const patch={ai:Object.assign({},ai,{segs:c.segs,lights:c.lights,summary:c.summary||ai.summary,at:Date.now(),prev:{segs:ai.segs,lights:p.lights,summary:ai.summary||""}}),lightsAt:null};
        if(got){patch.blocks=nb;patch.realH=null}
        patchLog(d,patch);
      }catch(e){btn.disabled=false;btn.textContent="Change";msg.textContent=aiErr(e)}
    }},"Change");
    inp.addEventListener("keydown",e=>{if(e.key==="Enter")btn.click()});
    sec.append(el("div",{class:"row",style:"margin-top:14px;flex-wrap:nowrap"},inp,btn),el("p",{class:"note",style:"margin:6px 0 0"},"Tell it what you actually did and it logs those blocks, or what to change and it re-plans the rest. Tap a row to log topics or change its time."),msg);
    sec.append(el("div",{class:"row",style:"margin-top:8px"},
      ai.prev?el("button",{class:"mini",onclick:()=>patchLog(d,{ai:Object.assign({},ai,{segs:ai.prev.segs,lights:ai.prev.lights,summary:ai.prev.summary,prev:null}),lightsAt:null})},"Undo last change"):null,
      el("button",{class:"mini",onclick:()=>{aiAsk[d]=true;renderDay(TS)}},"Plan again from questions"),
      el("button",{class:"mini",onclick:()=>openBlockLog(d,null)},"+ Log other study")));
  }else if(canWrite){
    sec.append(el("p",{class:"note",style:"margin:12px 0 0"},"Tap a row to log what you covered or change its time."),
      el("div",{class:"row",style:"margin-top:8px"},el("button",{class:"mini",onclick:()=>openBlockLog(d,null)},"+ Log other study")));
  }
  if(canWrite&&d<=todayIST()){
    const ri=el("input",{type:"number",id:"aiReal",min:"0",max:"20",step:"0.25",inputmode:"decimal",style:"width:90px",placeholder:(Math.round(done*4)/4).toString()});
    if(l.realH!=null)ri.value=l.realH;
    sec.append(el("div",{class:"row",style:"margin-top:14px"},el("label",{class:"note",for:"aiReal"},"Real hours today, if different"),ri,
      el("button",{class:"mini",onclick:()=>{const v=ri.value===""?null:Number(ri.value);if(v!=null&&(isNaN(v)||v<0))return;patchLog(d,{realH:v})}},"Save")));
  }
  return sec;
}
/* a study, news or paper row: minutes and a tick, the logged summary, and a tap for topics and time */
function blockRow(d,s,B,l,live,tap,src){
  const rec=B[s.id],lost=(l.lost||{})[s.id],light=(l.light||{})[s.id],stopped=l.stopAt!=null&&s.t>=l.stopAt;
  const hint=s.was?s.was:light?"light work":src==="ai"&&s.role==="study"?"":s.hint;
  const nm=el("span",{class:"nm"},el("b",{},s.name),hint?el("span",{class:"hint"}," · "+hint):null);
  if(rec&&((rec.items||[]).length||Object.keys(rec.topics||{}).length||rec.text||rec.nostudy))nm.append(el("span",{class:"sum"},"✓ "+rec.what+(rec.nostudy?" · not study":"")));
  else if(!rec&&(lost||stopped))nm.append(el("span",{class:"sum miss"},lost?"Lost":"Stopped"));
  let right=el("span");
  const paper=s.role==="paper",pm=s.e-s.t,rm=rec?Math.round((+rec.hours||0)*60):null,diffd=!!rec&&rm!==pm;
  if(canWrite&&lost)right=el("button",{class:"mini",onclick:()=>{const o=Object.assign({},l.lost);delete o[s.id];patchLog(d,{lost:Object.keys(o).length?o:null})}},"Undo");
  else if(!stopped||rec){
    const setMin=m=>{if(m>0){const r=Object.assign({},rec||{},{name:s.name,t:s.t,e:s.e,hours:m/60,at:Date.now()});if(!r.what)r.what=s.name;patchLog(d,{blocks:Object.assign({},B,{[s.id]:r}),realH:null})}else if(rec)patchLog(d,Object.assign(blockRemoval(l,s.id),{realH:null}))};
    const hb=el("button",{class:"hrbtn"+(diffd?" got":""),type:"button",disabled:!canWrite,"aria-label":"Minutes studied in "+s.name,onclick:()=>{
      if(paper){openBlockLog(d,s);return}
      const li=hb.closest("li");if(li.querySelector(".minrow"))return;
      const inp=el("input",{type:"number",min:"0",max:String(pm+120),step:"5",inputmode:"numeric",value:String(rm!=null?rm:pm),"aria-label":"Minutes studied in "+s.name,class:"mininp"});
      const ok=el("button",{class:"mini",type:"button",onclick:()=>{const v=Number(inp.value);if(inp.value===""||isNaN(v)||v<0)return;setMin(Math.round(v))}},"Save");
      inp.addEventListener("keydown",e=>{if(e.key==="Enter")ok.click()});
      li.append(el("div",{class:"row minrow",style:"grid-column:1/-1;gap:8px;justify-content:flex-end;padding-top:6px"},el("button",{class:"mini",type:"button",onclick:()=>openBlockLog(d,s)},"Topics and time"),el("span",{class:"tm"},"Studied"),inp,el("span",{class:"tm"},"min"),ok));inp.focus();inp.select()}},diffd?dur(rm)+" of "+dur(pm):dur(pm));
    right=el("span",{class:"row",style:"gap:10px;flex-wrap:nowrap"},hb,
      el("input",{type:"checkbox",id:"blk-"+s.id,checked:!!rec,disabled:!canWrite,"aria-label":"Done: "+s.name,onchange:e=>{if(paper){e.target.checked=!!rec;openBlockLog(d,s);return}setMin(e.target.checked?(rm||pm):0)}}))}
  const li=el("li",{class:"bl"+(live?" live":"")+(paper?" paper":"")},el("span",{class:"tm"},hmS(s.t)),nm,right);
  return stopped&&!rec?li:tap(li,()=>openBlockLog(d,s),(paper?"Paper: ":"Log ")+s.name);
}
function extraRow(d,B){const rec=B.evening;
  return el("li",{class:"bl"},el("span",{class:"tm"},"After 7"),el("span",{class:"nm"},el("b",{},"Extra study"),el("span",{class:"hint"}," · optional"),rec?el("span",{class:"sum"},"✓ "+(rec.what||"logged")+" · "+hrs(rec.hours||0)):null),
    canWrite?el("button",{class:"mini",onclick:()=>openBlockLog(d,{id:"evening",name:"Extra study",t:null,e:null})},rec?"Edit":"Log"):el("span"));
}
function rng(a,b){
  const f=m=>{m=Math.round(m);const h=Math.floor(m/60)%24,mm=m%60;return{t:((h+11)%12+1)+(mm?":"+String(mm).padStart(2,"0"):""),p:h>=12?"pm":"am"}};
  const x=f(a),y=f(b);return x.p===y.p?x.t+"–"+y.t+" "+y.p:x.t+" "+x.p+"–"+y.t+" "+y.p;
}
function dayText(d){
  const p=dayPlan(d,TS);if(!p.segs)return"";
  let n=0;const lines=[nice(d)];
  p.segs.forEach(sg=>{
    if(sg.k==="break"&&sg.label==="Log the day")return;
    const nm=sg.k==="break"?sg.label:(sg.name==="Study block"?"Study block "+(++n):sg.name);
    lines.push(rng(sg.t,sg.e)+"  "+nm)});
  lines.push(hm(p.lights).replace(":00","")+"  Lights out");
  return lines.join("\n");
}
function copyDay(d,btn){
  const txt=dayText(d);if(!txt)return;
  const done=ok=>{btn.textContent=ok?"Copied ✓":"Copy blocked";setTimeout(()=>{btn.textContent="Copy timetable"},2200)};
  const fb=()=>{const ta=el("textarea",{style:"position:fixed;opacity:0"});ta.value=txt;document.body.append(ta);ta.select();let ok=false;try{ok=document.execCommand("copy")}catch(e){}ta.remove();done(ok)};
  try{navigator.clipboard.writeText(txt).then(()=>done(true),fb)}catch(e){fb()}
}
function renderDay(T){
  const box=$("day");box.textContent="";
  const real=todayIST(),isToday=sel===real,mins=nowMins(),p=dayPlan(sel,T),l=logs[sel]||{};
  const ask=sel>=real&&canWrite&&(!p.ai||aiAsk[sel]);
  box.append(el("div",{class:"dayhead"},el("div",{},el("div",{class:"label"},isToday?"Today":sel<real?"Past day":"Coming up"),el("h2",{},nice(sel))),dayNav(real)));
  if(p.segs&&!ask){const cb=el("button",{class:"mini"},"Copy timetable");cb.onclick=()=>copyDay(sel,cb);box.append(el("div",{class:"row",style:"margin:0 0 12px"},cb))}
  if(isToday)box.append(thoughtCard(sel,p,T));
  if(testOn(sel,T)){const fixes=T.filter(t=>t.done&&t.fix).sort((a,b)=>a.date<b.date?1:-1).slice(0,4);
    if(fixes.length)box.append(el("aside",{class:"fixes"},el("div",{class:"label"},"Fixes for today's paper"),el("ul",{},fixes.map(t=>el("li",{},t.fix)))))}
  if(ask)box.append(askCard(sel,T,l));
  else box.append(p.segs?timetableView(sel,p,T,l,isToday,mins):untimedSection(sel,p,T,l));
  box.append(todoSection(sel,p,T,l,isToday,mins));
}

function itemLabel(i,T){
  const tn=id=>{const t=T.find(x=>x.id===id);return t?t.name.split(" · ")[0]:""};
  if(i.paper){const tt=T.find(x=>x.id===i.paper);return "Write "+tn(i.paper)+(tt&&tt.half?", 90 min":"")}
  if(i.rev)return "Revise for "+tn(i.rev)+", unticked topics first";
  if(i.upload){const tt=T.find(x=>x.id===i.upload);return tt&&tt.kind==="essay"?"Send the copy to Professor SP":"Upload the copy"}
  if(i.id==="law")return "Law: "+(nextLaw()||"");
  if(i.id==="ca"){const cs=caStage();return "CA notes: "+(cs?cs[1].split(" (")[0]:"")}
  if(i.id==="cl")return "CA notes or Law, your pick";
  if(i.id==="review")return "Sunday review, 15 min";
  return i.title;
}
function todoRows(d,p,T,l){
  const rows=[];rows.ticked=[];
  p.items.slice().sort((a,b)=>RANK(a)-RANK(b)).forEach(i=>{
    /* test day: every topic of today's test gets its own row, open ones first; nothing is removed automatically */
    if(i.rev){const t=T.find(x=>x.id===i.rev);if(t){const tk=ticks(t.id);topicsFor(i,d,T).forEach(n=>rows.push({label:"Topic "+n+" · "+topicText(t,T,n),done:!!tk[n],topic:[t.id,n]}));return}}
    if(i.prep){const t=T.find(x=>x.id===i.prep),sh=t.name.split(" · ")[0];let list=topicsFor(i,d,T);
      /* sectional tests, today only: a queue. Ticked topics leave the list and the next unticked one takes the place. */
      if(!t.flt&&d===clampDay(todayIST())){const tk=ticks(t.id),dr=drops(t.id),k=Math.max(1,allocFor(t,T)._k||list.length||1);
        t.topics.filter(n=>tk[n]===d&&!dr[n]).forEach(n=>rows.ticked.push([t.id,n,sh]));
        list=t.topics.filter(n=>!tk[n]&&!dr[n]).slice(0,k)}
      if(list.length)list.forEach(n=>rows.push({label:"Topic "+n+" · "+topicText(t,T,n),done:!!ticks(t.id)[n],topic:[t.id,n]}));
      else rows.push({label:sh+": revise what you've covered",done:itemDone(i,d,T,l),item:i});
      return}
    rows.push({label:itemLabel(i,T),done:itemDone(i,d,T,l),item:i,sub:i.id==="cl"?i.detail:null});
  });
  return rows;
}
function todoSection(d,p,T,l,isToday,mins){
  const rows=todoRows(d,p,T,l),tkd=rows.ticked||[],nd=rows.filter(r=>r.done).length+tkd.length,sec=el("section",{});
  sec.append(el("div",{class:"section-h"},el("h3",{},"To do"),el("span",{class:"note"},rows.length?(tkd.length?nd+" done today":nd+" of "+rows.length+" done"):"")));
  if(!rows.length){sec.append(el("p",{class:"note",style:"margin:0"},p.kind==="light"?"Nothing planned. Log anything you do.":p.kind==="off"?"Nothing planned. Rest properly.":"Nothing planned."));return sec}
  const ul=el("ul",{class:"todo"});
  rows.forEach((r,k)=>{const cid="td-"+d+"-"+k;
    ul.append(el("li",{class:r.done?"done":""},el("input",{type:"checkbox",id:cid,checked:r.done,disabled:!canWrite,onchange:e=>r.topic?setTopic(r.topic[0],r.topic[1],e.target.checked,d):tickItem(d,r.item,e.target.checked)}),
      el("label",{for:cid},r.label,r.sub?el("span",{class:"sub"},r.sub):null)))});
  sec.append(ul);
  if(tkd.length)sec.append(el("div",{class:"row",style:"margin-top:10px"},el("span",{class:"note"},"Done today"+(canWrite?", tap to untick:":": "+tkd.map(x=>x[2]+" · "+x[1]).join(", "))),
    canWrite?tkd.map(x=>el("button",{class:"mini","aria-label":"Untick "+x[2]+" topic "+x[1],onclick:()=>setTopic(x[0],x[1],false,d)},x[2]+" · "+x[1]+" ↩")):null));
  if(isToday&&p.segs&&p.start.set){const fit=fitItems(p,T,l,remaining(p,l,mins),d);
    const no=p.items.filter(i=>fit.map[i.id]&&fit.map[i.id].state==="no"&&!itemDone(i,d,T,l));
    if(no.length)sec.append(el("p",{class:"note",style:"margin:8px 0 0"},"Not enough time left today for: "+no.map(i=>i.prep?i.title.replace("Prep · ","").split(" · ")[0]+" topics":itemLabel(i,T)).join(", ")+". It moves forward."))}
  return sec;
}
function untimedSection(d,p,T,l){
  const sec=el("section",{}),B=l.blocks||{};
  sec.append(el("div",{class:"section-h"},el("h3",{},"Log")),
    Object.keys(B).length?el("ul",{class:"loglist"},Object.entries(B).map(([k,r])=>logLi(d,k,r))):el("p",{class:"note",style:"margin:0"},"No timetable today. Log what you do."),
    canWrite?el("div",{class:"row",style:"margin-top:12px"},el("button",{class:"mini primary",onclick:()=>openBlockLog(d,null)},"+ Log study")):null);
  return sec;
}
function logLi(d,k,r){return el("li",{},el("span",{class:"tm"},r.t!=null?hmS(r.t)+"–"+hmS(r.e):"Other"),el("span",{},el("span",{class:"nm"},r.name),(r.what||"")+(r.nostudy?" (not study)":""),canWrite&&r.t==null?el("button",{class:"mini",style:"margin-left:8px",onclick:()=>openBlockLog(d,{id:k,name:r.name,t:null,e:null,k:"extra"})},"Edit"):null),el("b",{},hrs(r.hours||0)))}

