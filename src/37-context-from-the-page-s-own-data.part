/* ---------- context from the page's own data ---------- */
/* the same count as the page: his real-hours figure if set, otherwise every logged block (newspaper included) except "not study" */
function studyHours(lg){if(!lg)return 0;if(lg.realH!=null)return +lg.realH;const b=Object.values(lg.blocks||{});if(b.length)return b.reduce((s,x)=>x.nostudy?s:s+(+x.hours||0),0);return lg.hours!=null?+lg.hours:0}
function effDate(st,id){const o=(st.tests||{})[id];const after=o&&(o.moves||[]).some(m=>m.at>=REPLAN);
  if(o&&o.done)return null;if(o&&o.skipped&&after)return null;return after?o.date:BASE[id]}
async function context(){
  const d=today(),lines=["Today: "+d+" (India time "+hm(new Date(Date.now()+330*60000).getUTCHours()*60+new Date(Date.now()+330*60000).getUTCMinutes())+")."];
  if(!DB)return lines.join("\n");
  try{
    const ids=[0,1,2,3,4,5,6].map(i=>addD(d,-i));
    const snaps=await Promise.all(ids.map(x=>DB.doc("logs/"+x).get().catch(()=>null)).concat([DB.doc("plan/state").get().catch(()=>null),DB.doc("food/"+d).get().catch(()=>null),DB.doc("coach/memory").get().catch(()=>null),DB.doc("study/"+d).get().catch(()=>null),DB.doc("journal/"+d).get().catch(()=>null)]));
    const lg=snaps[0]&&snaps[0].exists?snaps[0].data():null;
    if(lg){lines.push("Woke at "+hm(lg.start)+(lg.asleep!=null?"; fell asleep the night before at "+hm(lg.asleep):"")+". Study logged so far today: "+studyHours(lg).toFixed(1)+" h.");
      const bl=Object.values(lg.blocks||{}).map(b=>(b.name||"Block")+(b.what&&b.what!==b.name?" ("+b.what+")":"")+": "+(+b.hours||0).toFixed(1)+" h").join("; ");if(bl)lines.push("Today's logged blocks: "+bl+".");
      if(lg.note)lines.push("His note today: "+lg.note);}
    else lines.push("Nothing logged yet today.");
    const wk=[];for(let i=1;i<7;i++){const s=snaps[i];if(s&&s.exists){const x=s.data();wk.push(ids[i]+": "+studyHours(x).toFixed(1)+" h"+(x.start!=null?", woke "+hm(x.start):"")+(x.asleep!=null?", fell asleep "+hm(x.asleep):"")+(x.note?", note: "+String(x.note).slice(0,160):""))}}
    if(wk.length)lines.push("Recent days:\n"+wk.join("\n"));
    const st=snaps[7]&&snaps[7].exists?snaps[7].data():{};
    const up=Object.keys(BASE).map(id=>({id,date:effDate(st,id)})).filter(x=>x.date&&x.date>=d).sort((a,b)=>a.date<b.date?-1:1);
    const nx=up[0],dl=up.find(x=>x.id[0]==="F");
    const MR=window.MR,tt=MR?MR.dayText(d):"";
    if(tt)lines.push("TODAY'S TIMETABLE ON HIS PAGE (what he sees now, with what he has logged):\n"+tt);
    else lines.push("Today has no timetable on his page yet (he makes one with Plan my day on the Today tab).");
    if(MR)lines.push("HIS DAY RULES (from the page; the planner follows these):\n"+String(MR.bookText()).slice(0,2500));
    if(nx)lines.push("Next paper: "+NAMES[nx.id]+" on "+nx.date+" ("+(dd(d,nx.date)===0?"today":dd(d,nx.date)+" day"+(dd(d,nx.date)===1?"":"s")+" away")+")."+(nx.id==="ST2"?" Its submission window closes 27 Nov, the absolute latest.":""));
    if(dl)lines.push("Next Delhi full-length test: "+NAMES[dl.id]+" on "+dl.date+" ("+dd(d,dl.date)+" days away). UPSC Prelims is around 24 May 2027.");
    const fd=snaps[8]&&snaps[8].exists?(snaps[8].data().entries||[]):[];if(fd.length)lines.push("Food logged today: "+fd.map(x=>x.text).join("; "));
    const mem=snaps[9]&&snaps[9].exists?snaps[9].data():null;if(mem){if((mem.stories||[]).length)lines.push("Stories already told him in earlier chats (do not repeat): "+mem.stories.slice(-60).join("; "));if((mem.notes||[]).length)lines.push("Your saved coach notes:\n- "+mem.notes.slice(-25).join("\n- "))}
    const sd=snaps[10]&&snaps[10].exists?(snaps[10].data().entries||[]):[];if(sd.length)lines.push("Study he reported to you today: "+sd.map(x=>x.subject+", "+x.covered+" ("+x.hours+" h"+(x.pass!=null?", reading "+x.pass:"")+")").join("; "));
    const jd=snaps[11]&&snaps[11].exists?(snaps[11].data().entries||[]):[];if(jd.length)lines.push("Coach journal today: "+jd.map(x=>x.text).join(" | "));
  }catch(e){}
  return lines.join("\n");
}

